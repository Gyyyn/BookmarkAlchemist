{
  "manifest_version": 2,
  "name": "Bookmark Alchemist",
  "version": "2025.2.1",
  "description": "Go beyond your browsers bookmarks. Search your personal bookmarks directly from the omnibox.",

  "permissions": [
    "storage",
    "notifications",
    "clipboardWrite"
  ],

  "background": {
    "scripts": [
      "browser-polyfill.min.js",
      "background.js"
    ]
  },

  "omnibox": {
    "keyword": "bm"
  },
  "browser_action": {
    "default_title": "Open Cauldron",
    "default_popup": "bookmarks.html"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "gabrielhfrn@vivaldi.net",
      "strict_min_version": "57.0"
    }
  },

  "icons": {
    "48": "maskable_icon_x48.png",
    "128": "maskable_icon_x128.png",
    "512": "maskable_icon_x512.png"
  }
}