{
  "manifest_version": 2,
  "name": "Bookmark Alchemist: Your Personal Bookmark Search Engine",
  "version": "1.0",
  "description": "Go beyond your browsers bookmarks. Search your personal bookmarks directly from the omnibox.",

  "permissions": [
    "storage"
  ],

  "background": {
    "scripts": [
      "browser-polyfill.min.js",
      "background.js"
    ]
  },

  "omnibox": {
    "keyword": "bm"
  },

  "browser_action": {
    "default_title": "Open Cauldron",
    "default_popup": "bookmarks.html"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "bookmark-alchemist@your-email-or-domain.com",
      "strict_min_version": "57.0"
    }
  },

  "icons": {
    "128": "bookmark.png"
  }
}